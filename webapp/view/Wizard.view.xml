<mvc:View
    controllerName="cv.viewer.cvviewer.controller.Wizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="wizardPage"
        title="Editor de CV"
        showNavButton="false"
        backgroundDesign="Solid"
        showFooter="true">

        <content>
            <Wizard
                id="wizard"
                showNextButton="false"
                stepActivate=".onStepActivate"
                complete=".onWizardComplete">

                <WizardStep
                    id="stepProfile"
                    title="Perfil"
                    icon="sap-icon://person-placeholder"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step1Profile"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepSkills"
                    title="Skills"
                    icon="sap-icon://learning-assistant"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step2Skills"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepExperience"
                    title="Experiencia"
                    icon="sap-icon://building"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step3Experience"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepProjects"
                    title="Proyectos"
                    icon="sap-icon://collaborate"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step4Projects"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepEducation"
                    title="Educación"
                    icon="sap-icon://education"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step5Education"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepCertifications"
                    title="Certificaciones"
                    icon="sap-icon://certificate"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step6Certifications"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepLanguages"
                    title="Idiomas"
                    icon="sap-icon://world"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step7Languages"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepLeads"
                    title="Leads"
                    icon="sap-icon://customer"
                    complete="false">
                    <VBox class="sapUiMediumMargin">
                        <Title
                            text="Contactos recibidos"
                            level="H3" />

                        <Text
                            text="Listado de recruiters o empresas que dejaron sus datos desde la app pública."
                            class="sapUiSmallMarginBottom" />

                        <Table
                            id="tblRecruiterLeads"
                            items="{wizard>/recruiterLeads}"
                            inset="false"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingScrollToLoad="true"
                            width="100%">

                            <columns>
                                <Column width="9rem">
                                    <Text text="Fecha" />
                                </Column>
                                <Column width="12rem">
                                    <Text text="Nombre" />
                                </Column>
                                <Column width="14rem">
                                    <Text text="Email" />
                                </Column>
                                <Column width="12rem">
                                    <Text text="Empresa" />
                                </Column>
                                <Column width="10rem">
                                    <Text text="Teléfono" />
                                </Column>
                                <Column width="10rem">
                                    <Text text="Rol" />
                                </Column>
                                <Column width="10rem">
                                    <Text text="Estado" />
                                </Column>
                                <Column>
                                    <Text text="Mensaje" />
                                </Column>
                                <Column width="14rem">
                                    <Text text="Acciones" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem vAlign="Top">
                                    <cells>
                                        <Text text="{wizard>createdAtFormatted}" />
                                        <Text text="{wizard>fullName}" wrapping="true" />
                                        <Text text="{wizard>email}" wrapping="true" />
                                        <Text text="{wizard>company}" wrapping="true" />
                                        <Text text="{wizard>phone}" wrapping="true" />
                                        <Text text="{wizard>role}" wrapping="true" />
                                        <ObjectStatus
                                            text="{wizard>status}"
                                            state="{wizard>statusState}" />
                                        <Text text="{wizard>message}" wrapping="true" />
                                        <HBox wrap="Wrap">
                                            <Button
                                                text="Contactado"
                                                type="Success"
                                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                                press=".onMarkLeadAsContacted"
                                                visible="{= ${wizard>status} !== 'CONTACTED' }" />
                                            <Button
                                                text="Descartar"
                                                type="Reject"
                                                class="sapUiTinyMarginBottom"
                                                press=".onDiscardLead"
                                                visible="{= ${wizard>status} !== 'DISCARDED' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </WizardStep>

            </Wizard>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    id="btnBack"
                    text="Anterior"
                    icon="sap-icon://navigation-left-arrow"
                    visible="false"
                    press=".onBack"/>
                <Button
                    id="btnNext"
                    text="Siguiente"
                    icon="sap-icon://navigation-right-arrow"
                    iconFirst="false"
                    type="Emphasized"
                    press=".onNext"/>
                <Button
                    id="btnFinish"
                    text="Finalizar"
                    icon="sap-icon://accept"
                    type="Success"
                    visible="false"
                    press=".onWizardComplete"/>
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>