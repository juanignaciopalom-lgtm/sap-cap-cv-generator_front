<mvc:View
    controllerName="cv.viewer.cvviewer.controller.Wizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="wizardPage"
        title="Editor de CV"
        showNavButton="false"
        backgroundDesign="Solid"
        showFooter="true"
        busy="{wizard>/busy}">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Editor de CV" level="H3" />
                </contentLeft>
                <contentRight>
                    <Button
                        text="Logout"
                        icon="sap-icon://log"
                        type="Transparent"
                        press=".onLogout" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <Wizard
                id="wizard"
                showNextButton="false"
                stepActivate=".onStepActivate"
                complete=".onWizardComplete">

                <WizardStep
                    id="stepProfile"
                    title="Perfil"
                    icon="sap-icon://person-placeholder"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step1Profile"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepSkills"
                    title="Skills"
                    icon="sap-icon://learning-assistant"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step2Skills"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepExperience"
                    title="Experiencia"
                    icon="sap-icon://building"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step3Experience"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepProjects"
                    title="Proyectos"
                    icon="sap-icon://collaborate"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step4Projects"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepEducation"
                    title="Educación"
                    icon="sap-icon://education"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step5Education"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepCertifications"
                    title="Certificaciones"
                    icon="sap-icon://certificate"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step6Certifications"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepLanguages"
                    title="Idiomas"
                    icon="sap-icon://world"
                    complete="false">
                    <core:Fragment
                        fragmentName="cv.viewer.cvviewer.view.steps.Step7Languages"
                        type="XML"/>
                </WizardStep>

                <WizardStep
                    id="stepLeads"
                    title="Leads"
                    icon="sap-icon://customer"
                    complete="false">

                    <VBox class="sapUiMediumMargin recruiterLeadsSection">

                        <HBox
                            class="sapUiSmallMarginBottom recruiterLeadsHeader"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            wrap="Wrap">

                            <VBox class="recruiterLeadsHeaderText">
                                <Title
                                    text="Contactos recibidos"
                                    level="H3" />
                                <Text
                                    text="Listado de recruiters o empresas que dejaron sus datos desde la app pública."
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <HBox
                                class="recruiterLeadsFilterBox sapUiTinyMarginTop"
                                alignItems="Center"
                                wrap="Wrap">
                                <Label
                                    text="Filtrar por"
                                    labelFor="selectLeadFilter"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginTop" />
                                <Select
                                    id="selectLeadFilter"
                                    selectedKey="{wizard>/leadFilter}"
                                    change=".onLeadFilterChange"
                                    width="13rem"
                                    class="sapUiTinyMarginTop">
                                    <items>
                                        <core:Item key="ACTIVE" text="Activos" />
                                        <core:Item key="NEW" text="Nuevos" />
                                        <core:Item key="BPA_TRIGGERED" text="BPA disparados" />
                                        <core:Item key="BPA_FAILED" text="BPA fallidos" />
                                        <core:Item key="CONTACTED" text="Contactados" />
                                        <core:Item key="DISCARDED" text="Descartados" />
                                        <core:Item key="ALL" text="Todos" />
                                    </items>
                                </Select>
                            </HBox>
                        </HBox>

                        <Table
                            id="tblRecruiterLeads"
                            class="recruiterLeadsTable"
                            items="{wizard>/recruiterLeads}"
                            inset="false"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingScrollToLoad="true"
                            width="100%"
                            autoPopinMode="true">

                            <columns>
                                <Column
                                    width="9rem"
                                    minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Fecha" />
                                </Column>

                                <Column width="12rem">
                                    <Text text="Nombre" />
                                </Column>

                                <Column
                                    width="14rem"
                                    minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Email" />
                                </Column>

                                <Column
                                    width="12rem"
                                    minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Empresa" />
                                </Column>

                                <Column
                                    width="10rem"
                                    minScreenWidth="Desktop"
                                    demandPopin="true">
                                    <Text text="Teléfono" />
                                </Column>

                                <Column
                                    width="10rem"
                                    minScreenWidth="Desktop"
                                    demandPopin="true">
                                    <Text text="Rol" />
                                </Column>

                                <Column width="11rem">
                                    <Text text="Estado" />
                                </Column>

                                <Column
                                    width="14rem"
                                    minScreenWidth="Desktop"
                                    demandPopin="true">
                                    <Text text="Error BPA" />
                                </Column>

                                <Column
                                    minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Mensaje" />
                                </Column>

                                <Column width="24rem">
                                    <Text text="Acciones" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem
                                    vAlign="Top"
                                    type="Inactive"
                                    class="recruiterLeadRow">

                                    <cells>
                                        <Text text="{wizard>createdAtFormatted}" />
                                        <Text text="{wizard>fullName}" wrapping="true" />
                                        <Text text="{wizard>email}" wrapping="true" />
                                        <Text text="{wizard>company}" wrapping="true" />
                                        <Text text="{wizard>phone}" wrapping="true" />
                                        <Text text="{wizard>role}" wrapping="true" />

                                        <ObjectStatus
                                            text="{wizard>statusText}"
                                            state="{wizard>statusState}"
                                            class="leadStatusBadge" />

                                        <Text text="{wizard>bpaErrorMessage}" wrapping="true" />
                                        <Text text="{wizard>message}" wrapping="true" />

                                        <HBox
                                            wrap="Wrap"
                                            class="leadActionsBox">

                                            <Button
                                                text="Enviar a BPA"
                                                type="Emphasized"
                                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                                press=".onTriggerLeadBpa"
                                                visible="{= ${wizard>status} === 'NEW' }" />

                                            <Button
                                                text="Reintentar BPA"
                                                type="Attention"
                                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                                press=".onRetryLeadBpa"
                                                visible="{= ${wizard>status} === 'BPA_FAILED' }" />

                                            <Button
                                                text="Contactado"
                                                type="Success"
                                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                                press=".onMarkLeadAsContacted"
                                                visible="{= ${wizard>status} !== 'CONTACTED' }" />

                                            <Button
                                                text="Descartar"
                                                type="Reject"
                                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                                press=".onDiscardLead"
                                                visible="{= ${wizard>status} !== 'DISCARDED' }" />

                                            <Button
                                                text="Eliminar"
                                                type="Negative"
                                                class="sapUiTinyMarginBottom"
                                                press=".onDeleteLead" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </WizardStep>

            </Wizard>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    id="btnBack"
                    text="Anterior"
                    icon="sap-icon://navigation-left-arrow"
                    visible="false"
                    press=".onBack"/>
                <Button
                    id="btnNext"
                    text="Siguiente"
                    icon="sap-icon://navigation-right-arrow"
                    iconFirst="false"
                    type="Emphasized"
                    press=".onNext"/>
                <Button
                    id="btnFinish"
                    text="Finalizar"
                    icon="sap-icon://accept"
                    type="Success"
                    visible="false"
                    press=".onWizardComplete"/>
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>